#!/usr/bin/env python3
"""Writes docs/KIT-API.md from the public symbols of this package (SwiftPM's symbol graph), so it cannot drift from the code.
   usage: scripts/gen-kit-api          (builds the kit's symbol graph; needs only the Swift toolchain)"""
import json, glob, os, subprocess, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
kit = root
subprocess.run(["swift", "package", "dump-symbol-graph", "--minimum-access-level", "public"], cwd=kit, check=True, capture_output=True)
files = glob.glob(os.path.join(kit, ".build", "**", "RiskellKit.symbols.json"), recursive=True)
if not files: sys.exit("gen-kit-api: no symbol graph found")
g = json.load(open(max(files, key=os.path.getmtime)))
syms = {s["identifier"]["precise"]: s for s in g["symbols"]}
members = {}
for r in g["relationships"]:
    if r["kind"] in ("memberOf", "optionalRequirementOf", "requirementOf") and "sourceOrigin" not in r and r["source"] in syms and r["target"] in syms:
        members.setdefault(r["target"], []).append(r["source"])
def decl(s): return "".join(f["spelling"] for f in s.get("declarationFragments", [])).strip()
def doc(s): return " ".join(l["text"].strip() for l in s.get("docComment", {}).get("lines", []) if l["text"].strip()) if s.get("docComment") else ""
top = [s for pid, s in syms.items() if len(s["pathComponents"]) == 1 and s["kind"]["identifier"] in
       ("swift.struct", "swift.enum", "swift.protocol", "swift.class", "swift.func", "swift.var", "swift.typealias")]
order = ["Pal", "T", "G", "Tone", "Reading", "Metric", "ReadingBody", "ReadingCardContent", "Num", "Cap", "Sep", "Bar", "VGauge", "Sparkline", "Rule", "Dot", "Sheen",
         "AtomMeta", "ReadingAtom", "CustomAtom", "Card", "RiskellPackage",
         "Behaviour", "ManagerEvent", "ManagerState", "ManagedWindow", "ManagedWorkspace", "ManagerCommand", "ManagerHook",
         "Env", "Prefs", "Feed", "BatteryState", "VolumeState", "FocusedApp", "SpacesState", "PopEdge"]
rank = {n: i for i, n in enumerate(order)}
top.sort(key=lambda s: (rank.get(s["names"]["title"], 999), s["names"]["title"]))
out = ["# RiskellKit API", "",
       "Generated by `scripts/gen-kit-api` from the public symbols of this package; do not edit. The how-to is `docs/WRITING-EXTENSIONS.md` in the [riskell repository](https://github.com/rish139/riskell).",
       "Everything not listed here is not available to an extension, on purpose (`docs/EXTENSION-KIT.md` in the riskell repository).", ""]
for s in top:
    out += [f"## `{s['names']['title']}`", "", "```swift", decl(s), "```", ""]
    if doc(s): out += [doc(s), ""]
    ms = sorted((syms[m] for m in members.get(s["identifier"]["precise"], [])), key=lambda m: (m["kind"]["identifier"] != "swift.init", m["names"]["title"]))
    if ms:
        out += ["| member | |", "|---|---|"]
        for m in ms:
            out.append(f"| `{decl(m).replace('|', chr(92) + '|')}` | {doc(m).replace('|', chr(92) + '|')} |")
        out.append("")
open(os.path.join(root, "docs", "KIT-API.md"), "w").write("\n".join(out))
print("wrote docs/KIT-API.md:", len(top), "top-level symbols")
